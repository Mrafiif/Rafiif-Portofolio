---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import Certifications from '../components/sections/Certifications.astro';
import Contact from '../components/sections/Contact.astro';
import VelocityMarquee from '../components/react/VelocityMarquee';
import IntroHero from '../components/react/IntroHero';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import portraitCutout from '../assets/portrait-cutout.png';

// Transparent cut-out portrait for the intro (keeps alpha as WebP).
const portrait = await getImage({ src: portraitCutout, width: 684, format: 'webp', quality: 85 });

const marqueeRows = [
  ['Full-Stack Development', 'AI Integration', 'Speech-to-Text', 'IT Infrastructure'],
  ['FastAPI', 'Node.js', 'React', 'PostgreSQL', 'Flutter', 'Networking'],
];
---

<Layout overlayHeader>
  <IntroHero
    client:load
    firstName={site.firstName}
    lastName={site.lastName}
    portrait={{ src: portrait.src, width: Number(portrait.attributes.width), height: Number(portrait.attributes.height) }}
    roles={['Full-Stack Developer', 'IT Support Intern @ Yili', 'AI Tool Builder', 'Ex-Intern @ Kemenkeu RI']}
    location={site.location}
    socials={site.socials}
  />
  <Hero />
  <About />
  <Experience />
  <div aria-hidden="true" class="overflow-hidden">
    <VelocityMarquee client:visible rows={marqueeRows} />
  </div>
  <Projects />
  <Skills />
  <Certifications />
  <Contact />
</Layout>
