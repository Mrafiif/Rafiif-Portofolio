---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import Certifications from '../components/sections/Certifications.astro';
import Contact from '../components/sections/Contact.astro';
import VelocityMarquee from '../components/react/VelocityMarquee';

const marqueeRows = [
  ['Full-Stack Development', 'AI Integration', 'Speech-to-Text', 'IT Infrastructure'],
  ['FastAPI', 'Node.js', 'React', 'PostgreSQL', 'Flutter', 'Networking'],
];
---

<Layout>
  <Hero />
  <About />
  <Experience />
  <div aria-hidden="true" class="overflow-hidden">
    <VelocityMarquee client:visible rows={marqueeRows} />
  </div>
  <Projects />
  <Skills />
  <Certifications />
  <Contact />
</Layout>
