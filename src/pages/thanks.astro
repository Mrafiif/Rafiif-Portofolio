---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Message sent">
  <section class="container-page grid min-h-[70dvh] place-items-center py-20 text-center">
    <div class="max-w-md">
      <span class="mx-auto mb-6 grid size-14 place-items-center rounded-full bg-accent-soft text-accent">
        <Icon name="check" size={26} />
      </span>
      <h1 class="text-4xl font-light tracking-tight">Thanks — message received.</h1>
      <p class="mt-4 text-muted">I’ll get back to you by email.</p>
      <a href="/" class="btn btn-primary mt-8"><Icon name="arrow-left" size={15} /> Back to home</a>
    </div>
  </section>
</Layout>
