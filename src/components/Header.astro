---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
// On small screens section navigation lives in the floating Dock (src/components/react/Dock.tsx).
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300 [&.scrolled]:border-line [&.scrolled]:bg-bg/75 [&.scrolled]:backdrop-blur-md" data-header>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="group font-display text-[15px] font-extrabold tracking-tight" aria-label={`${site.name} — home`}>
      RAFIIF<span class="text-accent">.</span>DZ<span class="ml-0.5 inline-block w-2 animate-pulse text-accent">_</span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8 font-mono text-[11px] tracking-[0.22em] text-muted uppercase">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="relative py-2 transition-colors hover:text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform hover:after:scale-x-100">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="grid size-9 place-items-center rounded-full border border-line bg-surface/60 text-muted backdrop-blur transition-colors hover:border-accent hover:text-accent"
        aria-label="Toggle color theme"
        data-theme-toggle
      >
        <Icon name="sun" class="hidden [[data-theme=dark]_&]:block" />
        <Icon name="moon" class="block [[data-theme=dark]_&]:hidden" />
      </button>
      <a
        href="/#contact"
        class="rounded-md border border-ink/80 px-4 py-2 font-mono text-[11px] font-medium tracking-[0.18em] uppercase transition-colors hover:border-accent hover:bg-accent hover:text-accent-ink"
      >
        Contact me
      </a>
    </div>
  </div>
</header>

<script>
  const onScroll = () =>
    document.querySelector('[data-header]')?.classList.toggle('scrolled', window.scrollY > 24);
  window.addEventListener('scroll', onScroll, { passive: true });

  function setup() {
    onScroll();
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      // Cross-fade the theme change where View Transitions are supported.
      const apply = () => {
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      };
      if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(apply);
      else apply();
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>
