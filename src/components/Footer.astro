---
import Icon from './Icon.astro';
import { site } from '../data/site';

const socials = [
  { href: site.socials.github, label: 'GitHub', icon: 'github' },
  { href: site.socials.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: site.socials.instagram, label: 'Instagram', icon: 'instagram' },
] as const;
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col items-center justify-between gap-4 py-8 text-sm text-muted sm:flex-row">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <ul class="flex items-center gap-2">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="grid size-9 place-items-center rounded-full border border-line transition-colors hover:border-accent hover:text-accent">
            <Icon name={s.icon} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
