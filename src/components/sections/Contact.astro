---
import Icon from '../Icon.astro';
import { site } from '../../data/site';

const thanksUrl = new URL('/thanks/', Astro.site).href;
const field =
  'w-full rounded-xl border border-line bg-bg px-4 py-3 text-[0.95rem] placeholder:text-faint transition-colors focus:border-accent focus:outline-none';
---

<section id="contact" class="relative overflow-hidden border-t border-line">
  <div aria-hidden class="pointer-events-none absolute -top-40 left-1/4 size-[36rem] rounded-full bg-[radial-gradient(circle,var(--glow),transparent_65%)] blur-2xl"></div>
  <div class="container-page relative grid gap-14 py-20 sm:py-28 lg:grid-cols-2 lg:gap-20">
    <div>
      <p class="eyebrow mb-3">// 06 · Contact</p>
      <h2 class="text-[clamp(2.4rem,6vw,4rem)] leading-[1.05] font-medium tracking-tight">
        Let’s build something <em class="text-gradient">useful</em>.
      </h2>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-muted">
        Hiring for a developer or IT role, or have a project in mind? Send me a message or reach out on LinkedIn.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href={`mailto:${site.email}`} class="btn btn-primary">
          <Icon name="mail" size={15} /> {site.email}
        </a>
        <button
          type="button"
          class="btn btn-ghost"
          data-copy={site.email}
          aria-live="polite"
        >
          <Icon name="copy" size={15} /> <span data-copy-label>Copy</span>
        </button>
      </div>

      <ul class="mt-6 flex gap-2">
        <li><a href={site.socials.linkedin} target="_blank" rel="noopener" class="btn btn-ghost !px-4"><Icon name="linkedin" size={15} /> LinkedIn</a></li>
        <li><a href={site.socials.github} target="_blank" rel="noopener" class="btn btn-ghost !px-4"><Icon name="github" size={15} /> GitHub</a></li>
      </ul>
    </div>

    <form action={`https://formsubmit.co/${site.email}`} method="POST" class="card relative p-6 sm:p-8">
      <input type="hidden" name="_subject" value="New message from your portfolio" />
      <input type="hidden" name="_next" value={thanksUrl} />
      <input type="hidden" name="_template" value="table" />
      <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Name</span>
          <input type="text" name="name" required autocomplete="name" placeholder="Your name" class={field} />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Email</span>
          <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" class={field} />
        </label>
      </div>
      <label class="mt-4 block">
        <span class="mb-1.5 block text-sm font-medium">Company <span class="font-normal text-faint">(optional)</span></span>
        <input type="text" name="company" autocomplete="organization" placeholder="Where you work" class={field} />
      </label>
      <label class="mt-4 block">
        <span class="mb-1.5 block text-sm font-medium">Message</span>
        <textarea name="message" required rows="5" placeholder="Tell me about the role or project…" class={`${field} resize-y`}></textarea>
      </label>
      <button type="submit" class="btn btn-primary mt-6 w-full !py-3">
        Send message <Icon name="arrow-right" size={15} />
      </button>
    </form>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        const label = btn.querySelector('[data-copy-label]');
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          if (label) label.textContent = 'Copied!';
        } catch {
          if (label) label.textContent = 'Copy failed';
        }
        setTimeout(() => label && (label.textContent = 'Copy'), 2000);
      }),
    );
  });
</script>
