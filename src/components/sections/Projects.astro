---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import TiltCard from '../react/TiltCard';
import { publishedProjects } from '../../data/projects';

const featured = publishedProjects.filter((p) => p.featured);
const others = publishedProjects.filter((p) => !p.featured);
---

<section id="projects" class="container-page py-20 sm:py-28">
  <SectionHeading
    eyebrow="Selected work"
    title="Projects"
    intro="Internal tools used at the Ministry of Finance, plus academic and personal projects across networking, mobile, data and design."
  />

  <ul class="space-y-6">
    {featured.map((p, i) => (
      <li class="reveal">
        <TiltCard client:visible max={3}>
        <a
          href={`/projects/${p.slug}/`}
          class="card group grid h-full overflow-hidden transition-[border-color,box-shadow] duration-300 hover:border-accent/50 hover:shadow-card lg:grid-cols-2"
        >
          <div class:list={['overflow-hidden bg-surface-2', i % 2 === 1 && 'lg:order-last']}>
            <Image
              src={p.cover}
              alt=""
              widths={[480, 800, 1100]}
              sizes="(min-width: 1024px) 560px, 100vw"
              class="aspect-[16/10] size-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
              transition:name={`cover-${p.slug}`}
            />
          </div>
          <div class="flex flex-col p-6 sm:p-10">
            <p class="font-mono text-xs text-faint">{p.context} · {p.year}</p>
            <h3 class="mt-3 font-serif text-3xl tracking-tight" transition:name={`title-${p.slug}`}>{p.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{p.summary}</p>
            <ul class="mt-6 flex flex-wrap gap-1.5">
              {p.stack.slice(0, 5).map((s) => <li class="chip">{s}</li>)}
            </ul>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-8 text-sm font-medium text-accent">
              Read case study
              <Icon name="arrow-right" size={15} class="transition-transform group-hover:translate-x-1" />
            </span>
          </div>
        </a>
        </TiltCard>
      </li>
    ))}
  </ul>

  <h3 class="mt-20 mb-6 font-mono text-xs tracking-wider text-faint uppercase">More projects</h3>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {others.map((p) => (
      <li class="reveal">
        <TiltCard client:visible>
        <a href={`/projects/${p.slug}/`} class="card group flex h-full flex-col overflow-hidden transition-colors hover:border-accent/50">
          <div class="overflow-hidden border-b border-line bg-surface-2">
            <Image
              src={p.cover}
              alt=""
              widths={[400, 700]}
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
              class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              transition:name={`cover-${p.slug}`}
            />
          </div>
          <div class="flex flex-1 flex-col p-5">
            <p class="font-mono text-xs text-faint">{p.category}</p>
            <h4 class="mt-2 font-serif text-xl" transition:name={`title-${p.slug}`}>{p.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.summary}</p>
            <span class="mt-auto flex items-center gap-1 pt-5 text-sm text-ink group-hover:text-accent">
              Details <Icon name="arrow-up-right" size={14} />
            </span>
          </div>
        </a>
        </TiltCard>
      </li>
    ))}
  </ul>
</section>
