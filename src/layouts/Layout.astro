---
import { Font, getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/react/Dock';
import Cursor from '../components/react/Cursor';
import { site } from '../data/site';
import profile from '../assets/profile.jpg';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  /** The page starts with a full-bleed section that sits under the fixed header. */
  overlayHeader?: boolean;
}

const { title, description = site.description, image = profile, overlayHeader = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.shortName}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
  alumniOf: 'Universitas Al-Azhar Indonesia',
  sameAs: Object.values(site.socials),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f2f5f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#05070b" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <Font cssVariable="--font-unbounded" preload />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />

    <!-- Apply the saved theme before first paint (and again after each client-side navigation). -->
    <script is:inline>
      function applyTheme(doc) {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        doc.documentElement.dataset.theme = t;
      }
      applyTheme(document);
      document.addEventListener('astro:before-swap', (e) => applyTheme(e.newDocument));
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-bg">
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={[!overlayHeader && 'pt-16']}>
      <slot />
    </main>
    <Footer />
    <Dock client:idle transition:persist />
    <Cursor client:only="react" transition:persist />

    <script>
      // Smooth (inertia) scrolling. Skipped for reduced-motion users.
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      const lenis = matchMedia('(prefers-reduced-motion: reduce)').matches ? null : new Lenis({ autoRaf: true });
      document.addEventListener('astro:after-swap', () => lenis?.resize());

      // Same-page anchor links (e.g. "/#about" while on "/"). Handled here in the capture phase so that
      // only one thing scrolls: letting Lenis, the browser's hash jump and Astro's router all react to the
      // same click made them fight, and the page only moved a few pixels.
      document.addEventListener(
        'click',
        (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const link = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
          if (!link || link.target === '_blank') return;
          const url = new URL(link.href, location.href);
          if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash) return;
          const target = url.hash === '#top' ? 0 : document.getElementById(decodeURIComponent(url.hash.slice(1)));
          if (target === null) return;

          e.preventDefault();
          e.stopPropagation();
          // Both paths respect the html scroll-padding-top, which keeps sections clear of the fixed header.
          if (lenis) lenis.scrollTo(target);
          else if (target === 0) window.scrollTo({ top: 0 });
          else target.scrollIntoView();
          history.replaceState(history.state, '', url.hash);
        },
        { capture: true },
      );
    </script>
  </body>
</html>
